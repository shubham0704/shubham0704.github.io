  "variants": {
    "phast_partial": {
      "model": "phast_partial_qonly",
      "contract": "Position history plus the pendulum potential, mass model, coordinate chart, and damping base anchor; position-dependent PSD damping and permitted residual corrections are learned without an upper spectral cap. This is the uncapped ablation.",
      "model_kwargs": {
        "mass_mode": "constant",
        "warmstart": true
      }
    },
    "phast_partial_bounded": {
      "model": "phast_partial_qonly",
      "contract": "Position history plus the pendulum potential, mass model, coordinate chart, damping floor, and a declared 0.5 cap on damping variation; the bounded position-dependent PSD damping and permitted residual corrections are learned.",
      "model_kwargs": {
        "mass_mode": "constant",
        "damping_beta_sum_max": 0.5,
        "damping_beta_sum_policy": "fixed",
        "damping_d0_policy": "fixed",
        "warmstart": true
      }
    },
    "phast_unknown": {
      "model": "phast_unknown_qonly",
      "contract": "Position history and coordinate chart only; V, constant SPD M, bounded PSD D, and G are learned. The data-driven linear scaffold is initialized from the training split.",
      "model_kwargs": {
        "mass_mode": "constant",
        "warmstart": true
      }
    },
    "phast_no_damping": {
      "model": "phast_unknown_qonly",
      "contract": "The PHAST-UNKNOWN architecture and data-driven scaffold, with the damping channel removed. This is a causal ablation, not a competing method.",
      "model_kwargs": {
        "mass_mode": "constant",
        "damping_type": "none",
        "warmstart": true
      }
    },
    "phnn_observer": {
      "model": "phnn_observer_qonly",
      "contract": "Position history and coordinate chart only; a learned observer feeds a Hamiltonian model with learned PSD damping. No physical component is supplied.",
      "model_kwargs": {}
    },
    "s5": {
      "model": "s5",
      "contract": "Position history only; no supplied physical components and no explicit energy or damping channel.",
